# Meetprogramma voor de ESP32-S3 Super Mini.
# Zelfde instellingen als esp32s3/sdkconfig.defaults, zodat Mpu6050, BalansFilter
# en MotorDriver hier precies zo werken als in de robotfirmware.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Logging via de USB-C-poort van de Super Mini (native USB)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Tick van 1 ms: REGELPERIODE van 5 ms is dan precies 5 ticks.
CONFIG_FREERTOS_HZ=1000

# app_main op core 0; Mpu6050 draait op CORE_REGELING (core 1).
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y

# Optimaliseren op snelheid (-O2) voor filter en PID
CONFIG_COMPILER_OPTIMIZATION_PERF=y
