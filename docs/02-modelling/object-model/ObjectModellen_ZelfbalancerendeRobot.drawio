        </mxCell>
        <mxCell id="om ESP32-S3-44" parent="1" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;" value="&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; cellspacing=&quot;0&quot; style=&quot;border-collapse:collapse;width:100%;font-size:11px;text-align:left;vertical-align:top;&quot;&gt;&lt;tr style=&quot;background:#e6e6e6;&quot;&gt;&lt;th width=&quot;190&quot;&gt;Objectnaam&lt;/th&gt;&lt;th width=&quot;90&quot;&gt;Stereotype&lt;/th&gt;&lt;th&gt;Beschrijving&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;InitialiseerControl&lt;/td&gt;&lt;td&gt;control&lt;/td&gt;&lt;td&gt;&quot;Dirigent&quot; van use case &quot;Initialiseren&quot; (UC-S3-01).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BalanceerControl&lt;/td&gt;&lt;td&gt;control&lt;/td&gt;&lt;td&gt;&quot;Dirigent&quot; van use case &quot;Balanceren&quot; (UC-S3-02).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BalansverliesControl&lt;/td&gt;&lt;td&gt;control&lt;/td&gt;&lt;td&gt;&quot;Dirigent&quot; van use case &quot;Balansverlies afhandelen&quot; (UC-S3-03).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;VerstuurControl&lt;/td&gt;&lt;td&gt;control&lt;/td&gt;&lt;td&gt;&quot;Dirigent&quot; van use case &quot;Versturen&quot; (UC-S3-04). Stelt periodiek het bericht samen en voorziet het van een volgnummer.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;FoutControl&lt;/td&gt;&lt;td&gt;control&lt;/td&gt;&lt;td&gt;&quot;Dirigent&quot; van use case &quot;Fouttoestand afhandelen&quot; (UC-S3-05).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Mpu6050&lt;/td&gt;&lt;td&gt;boundary&lt;/td&gt;&lt;td&gt;Softwarekant van de MPU6050-sensor. Meet periodiek accelerometer en gyroscoop en meldt een sensor die niet reageert of ongeldige waarden levert.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BalansFilter&lt;/td&gt;&lt;td&gt;(geen)&lt;/td&gt;&lt;td&gt;Filtert en combineert accelerometer- en gyroscoopmetingen tot een balanswaarde en hoeksnelheid, gecorrigeerd voor een instelbaar nulpunt. Geen stereotype: het is pure signaalverwerking, zonder hardware, zonder regie en zonder eigen data die anderen opvragen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PidRegelaar&lt;/td&gt;&lt;td&gt;(geen)&lt;/td&gt;&lt;td&gt;Berekent uit een afwijking de proportionele, integrale en differentiele component en levert een begrensd correctiecommando. De integrale component kan gereset worden. Geen stereotype: pure berekening.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;MotorDriver&lt;/td&gt;&lt;td&gt;boundary&lt;/td&gt;&lt;td&gt;Softwarekant van de ZK5AD dubbele h-brug met de twee TT130-motoren. Zet richting en snelheid van de linker- en rechtermotor, en kan beide motoren stoppen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RobotStatus&lt;/td&gt;&lt;td&gt;entity&lt;/td&gt;&lt;td&gt;Bevat de robotstatus (KALIBREREN, BALANCEREN, BALANSVERLIES, FOUT), de valteller en het sessie-ID. Geen logische eigenaar: meerdere objecten gebruiken deze data.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;BalansData&lt;/td&gt;&lt;td&gt;entity&lt;/td&gt;&lt;td&gt;Bevat de actuele balanswaarde en bewegingsrichting als datapakket.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CydProxy&lt;/td&gt;&lt;td&gt;boundary&lt;/td&gt;&lt;td&gt;Proxy voor de CYD ESP32 (andere computer). Configureert de ESP-NOW-verbinding en verzendt berichten; een verzendfout blokkeert niets.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="520" width="1700" y="1060" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
