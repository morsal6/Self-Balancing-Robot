        <mxCell id="om ESP32-S3-43" edge="1" parent="1" source="om ESP32-S3-14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=8;fontSize=10;labelBackgroundColor=default;" target="om ESP32-S3-13" value="verstuurBericht(robotBericht)">
