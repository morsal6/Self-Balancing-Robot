ay as="points"><mxPoint x="304" y="422"/><mxPoint x="360" y="422"/></Array><mxPoint x="-7" y="71" as="offset"/></mxGeometry></mxCell><mxCell id="esp1note" value="Wachten wacht ook op eventBitVerstuur, dus after(VERZENDPERIODE) wordt&lt;br&gt;een one-shot software timer (verzendTimer) met een eigen eventbit.&lt;br&gt;Komen beide tegelijk, dan wordt er via de merge node één bericht verstuurd." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="28" y="535" width="500" height="59" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="esp2" name="Mpu6050"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="esp2fr" value="Mpu6050" style="shape=umlFrame;whiteSpace=wrap;html=1;width=80;height=26;" vertex="1" parent="1"><mxGeometry x="4" y="4" width="492" height="508" as="geometry"/></mxCell><mxCell id="esp2sep" value="" style="line;strokeWidth=1;html=1;" vertex="1" parent="1"><mxGeometry x="4" y="122" width="492" height="1" as="geometry"/></mxCell><mxCell id="esp2a0" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="49" y="66" width="20" height="20" as="geometry"/></mxCell><mxCell id="esp2a1" value="&lt;div style=&#x27;text-align:center&#x27;&gt;&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ start() / xEventGroupSetBits(eventGroup, eventBitStart)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="112" y="51" width="339" height="50" as="geometry"/></mxCell><mxCell id="esp2e2" style="endArrow=open;endSize=9;html=1;rounded=0;" edge="1" parent="1" source="esp2a0" target="esp2a1"><mxGeometry relative="1" as="geometry"/></mxCell><m