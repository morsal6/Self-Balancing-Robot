etry x="525" y="565" width="26" height="26" as="geometry"/></mxCell><mxCell id="cyd1b7" value="" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="691" y="700" width="26" height="26" as="geometry"/></mxCell><mxCell id="cyd1e8" value="/ score = 0;&#xa;heeftReferentie = false;&#xa;display.tekenScore(score)" style="endArrow=open;endSize=9;html=1;rounded=0;fontSize=10;align=left;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cyd1b3" target="cyd1b4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="212"/><mxPoint x="740" y="251"/></Array><mxPoint x="0" y="4" as="offset"/></mxGeometry></mxCell><mxCell id="cyd1e9" value="eventBitAangeraakt /&#xa;xEventGroupClearBits(eventGroup, eventBitAangeraakt);&#xa;score = 0;&#xa;display.tekenScore(score)" style="endArrow=open;endSize=9;html=1;rounded=0;fontSize=10;align=left;labelBackgroundColor=#ffffff;exitX=0.082;exitY=1.000;exitDx=0;exitDy=0;entryX=0.164;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cyd1b4" target="cyd1b4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="340"/><mxPoint x="310" y="340"/><mxPoint x="310" y="342"/><mxPoint x="632" y="342"/></Array><mxPoint x="-152" y="20" as="offset"/></mxGeometry></mxCell><mxCell id="cyd1e10" value="eventBitValteller&#xa;[tryReadQueue(valtellerQueue, info, eventGroup, eventBitValteller)]" style="endArrow=open;endSize=9;html=1;rounded=0;fontSize=10;align=left;labelBackgroundColor=#ffffff;exitX=0.247;exitY=1.000;exitDx=0;exitDy=0;entryX=0.500;entryY=0.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="cyd1b4" target="cyd1b5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="658" y="344"/><mxPoint x="538" y="380"/></Array><mxPoint x="-81" y="-1" as="offset"/></mxGeometry></mxCell><mxCell id="cyd1e11" value="[!heeftReferentie] /&#xa;refSessieId = info.sessieId;&#xa;re