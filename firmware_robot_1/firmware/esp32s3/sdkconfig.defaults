# ESP32-S3 Super Mini
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Logging via de USB-C-poort van de Super Mini (native USB)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Tick van 1 ms: REGELPERIODE van 5 ms is dan precies 5 ticks.
# Met de standaard 100 Hz wordt pdMS_TO_TICKS(5) nul.
CONFIG_FREERTOS_HZ=1000

# Core-verdeling (zie Ontwerpparameters.hpp):
#   core 0: app_main, WiFi-taak, esp_timer, Tmr Svc, VerstuurControl
#   core 1: RobotControl en Mpu6050 (de regellus), verder niets
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y

# Snellere floating point code voor filter en PID
CONFIG_COMPILER_OPTIMIZATION_PERF=y
